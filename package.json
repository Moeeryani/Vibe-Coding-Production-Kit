{
  "name": "vibe-coding-production",
  "version": "0.9.3",
  "description": "Production-grade vibe coding framework and CLI: specs, architecture, agent rules, testing, security, reviews, delivery, and safe lifecycle updates from idea to production.",
  "type": "module",
  "bin": {
    "vibe-coding-production": "bin/vibe-coding-production.mjs",
    "vcp": "bin/vibe-coding-production.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "AGENTS.md",
    "docs/",
    "prompts/",
    "examples/",
    "evaluations/",
    "scripts/",
    ".github/ISSUE_TEMPLATE/",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/validate.yml"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "test:cli": "node --test test/cli.test.mjs",
    "validate": "node scripts/validate-framework.mjs && npm run check && npm test",
    "pack:check": "npm pack --dry-run",
    "doctor": "node bin/vibe-coding-production.mjs doctor .",
    "prepublishOnly": "npm run validate",
    "adaptive:contracts": "node scripts/check-adaptive-contracts.mjs",
    "adaptive:local-gates": "node scripts/run-adaptive-local-gates.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "vibe-coding",
    "ai-coding",
    "coding-agents",
    "agentic-coding",
    "software-engineering",
    "spec-driven-development",
    "claude-code",
    "cursor",
    "codex",
    "github-copilot",
    "production-ready"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moeeryani/Vibe-Coding-Production-Kit.git"
  },
  "bugs": {
    "url": "https://github.com/Moeeryani/Vibe-Coding-Production-Kit/issues"
  },
  "homepage": "https://github.com/Moeeryani/Vibe-Coding-Production-Kit#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
