{
  "name": "vibe-coding-production",
  "version": "0.9.3",
  "description": "Production-grade vibe coding framework and CLI: specs, architecture, agent rules, testing, security, reviews, delivery, and safe lifecycle updates from idea to production.",
  "type": "module",
  "bin": {
    "vibe-coding-production": "bin/vibe-coding-production.mjs",
    "vcp": "bin/vibe-coding-production.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "AGENTS.md",
    "docs/",
    "prompts/",
    "examples/",
    "evaluations/",
    "scripts/",
    ".github/ISSUE_TEMPLATE/",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/validate.yml"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "build:native-linux": "c++ -std=c++17 -Wall -Wextra -O2 -o scripts/native/vcp-linux-fsops scripts/native/vcp-linux-fsops.cpp",
    "test": "node --test",
    "test:cli": "node --test test/cli.test.mjs",
    "validate": "node scripts/validate-framework.mjs && npm run check && npm run check:stage12-contract && npm run check:stage13-contract && npm run check:stage14-contract && npm test",
    "pack:check": "npm pack --dry-run",
    "doctor": "node bin/vibe-coding-production.mjs doctor .",
    "prepublishOnly": "npm run validate",
    "check:stage12-contract": "node scripts/check-stage12-readonly-contract.mjs",
    "check:stage13-contract": "node scripts/check-stage13-construction-contract.mjs",
    "test:stage13": "node --test test/stage13-bootstrap-crash.test.mjs test/stage13-cli-adoption.test.mjs test/stage13-committed-orphan.test.mjs test/stage13-directory-ownership.test.mjs test/stage13-init-gate.test.mjs test/stage13-lock-finality.test.mjs test/stage13-materialize.test.mjs test/stage13-native-exchange.test.mjs test/stage13-nested-recovery.test.mjs test/stage13-recovery-lock.test.mjs test/stage13-recovery-provenance.test.mjs test/stage13-replan-contract.test.mjs test/stage13-section-exchange.test.mjs test/stage13-transaction-recovery.test.mjs test/stage13-windows-ntfs.test.mjs",
    "test:stage14": "node --test test/stage14-consumer-assets.test.mjs test/stage14-dogfood.test.mjs test/stage14-legacy-validator.test.mjs",
    "check:stage14-contract": "node scripts/check-stage14-construction-contract.mjs",
    "build:native-windows": "node scripts/build-native-windows.mjs",
    "test:native-windows-candidate": "node scripts/run-native-windows-candidate-tests.mjs",
    "build:native-windows:verify-repro": "node scripts/build-native-windows.mjs --verify-repro",
    "inspect:d01-boundary": "node scripts/inspect-d01-boundary.mjs",
    "probe:d01-linux-isolation": "node scripts/run-d01-linux-isolation-fixture.mjs",
    "build:native-windows-d01-readonly": "node scripts/build-windows-d01-readonly.mjs",
    "build:native-windows-d01-readonly:verify-repro": "node scripts/build-windows-d01-readonly.mjs --verify-repro",
    "build:native-windows-d01-fixture": "node scripts/build-windows-d01-fixture.mjs",
    "build:native-windows-d01-fixture:verify-repro": "node scripts/build-windows-d01-fixture.mjs --verify-repro",
    "inspect:d01-windows-fixture": "node scripts/inspect-windows-d01-fixture.mjs",
    "review:d01-windows-fixture": "node scripts/review-windows-d01-fixture.mjs",
    "build:native-windows-d01-kernel-denial": "node scripts/build-windows-d01-kernel-denial.mjs",
    "build:native-windows-d01-kernel-denial:verify-repro": "node scripts/build-windows-d01-kernel-denial.mjs --verify-repro",
    "probe:d01-windows-kernel-denial": "node scripts/probe-windows-d01-kernel-denial.mjs",
    "plan:d01-windows-published-cli": "node scripts/plan-windows-d01-published-cli.mjs",
    "review:d01-windows-published-cli": "node scripts/review-windows-d01-published-cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "vibe-coding",
    "ai-coding",
    "coding-agents",
    "agentic-coding",
    "software-engineering",
    "spec-driven-development",
    "claude-code",
    "cursor",
    "codex",
    "github-copilot",
    "production-ready"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moeeryani/Vibe-Coding-Production-Kit.git"
  },
  "bugs": {
    "url": "https://github.com/Moeeryani/Vibe-Coding-Production-Kit/issues"
  },
  "homepage": "https://github.com/Moeeryani/Vibe-Coding-Production-Kit#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
